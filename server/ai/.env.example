# Configuração local: execute a partir de server/ai.
# Valores de exemplo; nenhuma credencial real deve ser versionada.
# PCM do navegador: mono, 16 kHz. CLI e servidor compartilham parte da configuração.

# Prompt da CLI; o cliente AssemblyAI da API usa apenas sample_rate e speech_model.
TRANSCRIPTION_PROMPT="Transcreva exclusivamente em português do Brasil. Priorize falas de sala de aula, explicações de professor, perguntas de aluno, instruções pedagógicas, vocabulário escolar e termos técnicos. Mantenha a pontuação simples e natural. Não traduza para inglês."
# Prompt da CLI; o cliente AssemblyAI da API usa apenas sample_rate e speech_model.
KEYTERMS_PROMPT="português do Brasil,aula,professor,aluno,escola,ensino,ensino médio,fundamental,vestibular,prova,exercício,simulado,apresentação,console,presença,Libras,inclusão,acessibilidade,exemplo,atividade,conteúdo,projeto,atividade prática,tarefa,declaração,pergunta,resposta,explicação"
SPEECH_MODEL=u3-rt-pro
TRANSCRIPT_OUTPUT_DIR=../../storage/transcripts/live
# O modelo precisa estar disponível; o primeiro carregamento pode exigir download.
LOCAL_FALLBACK_MODEL=medium
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_HOTWORDS="professor, professora, alunos, alunas, aula, escola, matéria, explicação, dúvida, exercício, prova, conteúdo, turma, questão, conceito, exemplo, teoria, matemática, português, história, geografia, biologia, física, química"
LOCAL_WHISPER_INITIAL_PROMPT="Transcrição em português do Brasil de uma aula presencial. Fala do professor e dos alunos sobre explicações pedagógicas, matérias escolares, termos didáticos e dúvidas em sala de aula."
INTERNET_PROBE_HOST=1.1.1.1
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1600
AUDIO_QUEUE_MAX_SIZE=8
AUDIO_MAX_QUEUE_AGE_MS=1200
AUDIO_READ_TIMEOUT_SECONDS=5
TRANSCRIPTION_RECV_TIMEOUT_SECONDS=30
MAX_RECONNECT_ATTEMPTS=5
INITIAL_RECONNECT_DELAY=2
MAX_RECONNECT_DELAY=30
LIST_AUDIO_DEVICES=0
DEBUG_LATENCY=0
USE_PORTUGUESE_PROMPT=1
LATENCY_LOG_INTERVAL_SECONDS=2
METRICS_LOG_INTERVAL_SECONDS=5
PARTIAL_SEND_STEP=2
PARTIAL_SEND_INTERVAL_MS=80
VAD_ENERGY_THRESHOLD=300
VAD_HOLD_SILENCE_MS=240
VAD_MODE=2
# WebRTC VAD de captura: somente CLI; navegador usa sua própria cadeia de áudio.
USE_WEBRTC_VAD=1
SAVE_TRANSCRIPTS=1
LOCAL_FALLBACK=1
LOCAL_WHISPER_CPU_THREADS=6
LOCAL_WHISPER_BEAM_SIZE=2
LOCAL_WHISPER_VAD_FILTER=1
LOCAL_WHISPER_VAD_MIN_SILENCE_MS=300
LOCAL_WHISPER_VAD_SPEECH_PAD_MS=200
LOCAL_WHISPER_NO_SPEECH_THRESHOLD=0.6
LOCAL_TRANSCRIPTION_CHUNK_SECONDS=2.5
LOCAL_TRANSCRIPTION_MIN_SECONDS=1.2
INTERNET_PROBE_PORT=53
INTERNET_PROBE_TIMEOUT=2
# Necessária somente para AssemblyAI; deixe vazia para tentar o fallback local.
ASSEMBLYAI_API_KEY=
# Seleção e listagem de microfone: somente CLI.
AUDIO_DEVICE=
LOG_LEVEL=INFO

# HTTP e diretórios relativos ao diretório de execução.
PORT=5455
OUTPUT_PATH=../../storage
MATERIAL_OUTPUT_DIR=../../storage/materials/ai
DOCUMENTATION_OUTPUT_DIR=../../storage/documentation

# Exportação por trecho final; diferente de SAVE_TRANSCRIPTS (TXT/JSON/SRT contínuos).
AUTO_SAVE_TRANSCRIPTS=0
AUTO_SAVE_FORMATS=pdf,txt,json

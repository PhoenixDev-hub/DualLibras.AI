# Local development through Vite's same-origin /api proxy.
NODE_ENV=development
PORT=4000
# Runtime only. Never copy real credentials to source or build arguments.
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
AI_INTERNAL_TOKEN=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
AUTH_COOKIE_NAME=festival_session
COOKIE_SECURE=false
# Set to 1 only when this API is inaccessible except through the trusted gateway.
TRUST_PROXY=0
AI_BACKEND_URL=http://127.0.0.1:5455
MATERIAL_UPLOAD_DIR=../../storage/materials/auth
MATERIAL_MAX_BYTES=26214400
AUTH_LOGIN_LIMIT=20
AUTH_SIGNUP_LIMIT=5
CLASSROOM_JOIN_LIMIT=20

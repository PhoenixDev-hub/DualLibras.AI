# Execute a API a partir de server/auth. Valores exclusivamente fictícios.
NODE_ENV=development
PORT=4000
# Conexão de execução; use o host real do seu PostgreSQL.
DATABASE_URL=postgresql://festival:senha_ficticia@localhost:5432/festival
# Lida por prisma.config.ts; conexão direta para ferramentas do Prisma.
DIRECT_URL=postgresql://festival:senha_ficticia@localhost:5432/festival
# Substitua por um segredo próprio antes de usar contas reais.
JWT_SECRET=substitua_por_um_segredo_local
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
AUTH_COOKIE_NAME=festival_session
COOKIE_SECURE=false
# Integração e armazenamento local de materiais.
AI_BACKEND_URL=http://localhost:5455
MATERIAL_UPLOAD_DIR=../../storage/materials/auth
MATERIAL_MAX_BYTES=26214400

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum Role {
  PROFESSOR
  ALUNO
  SOCIEDADE
  ADMIN
}

enum LessonStatus {
  AGENDADA
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
}

enum MaterialType {
  PDF
  DOCX
  PPTX
  OUTRO
}

enum SessionStatus {
  ATIVA
  FINALIZADA
  CANCELADA
}

// =========================
// USER
// =========================

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role

  schoolId String?
  school   School? @relation(
    fields: [schoolId],
    references: [id],
    onDelete: SetNull
  )

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  societyProfile SocietyProfile?

  // Salas criadas pelo professor
  classroomsOwned Classroom[] @relation("TeacherClassrooms")

  // Salas das quais o usuário participa
  memberships ClassroomMember[]

  // Aulas ministradas
  lessonsAsTeacher Lesson[] @relation("TeacherLessons")

  // Materiais enviados
  materials Material[] @relation("UploadedMaterials")

  // Sessões de transcrição
  transcriptionSessions TranscriptionSession[]

  // Glossários criados
  glossaries Glossary[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([schoolId])
}

// =========================
// PROFILES
// =========================

model TeacherProfile {
  id     String @id @default(uuid())
  userId String @unique

  discipline  String?
  institution String?

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique

  registrationNumber String?
  institution        String?

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocietyProfile {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// SCHOOL
// =========================

model School {
  id    String @id @default(uuid())
  name  String
  city  String?
  state String?

  users      User[]
  classrooms Classroom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// CLASSROOM
// =========================

model Classroom {
  id String @id @default(uuid())

  name        String
  description String?

  // Código utilizado pelos alunos
  // para entrar na sala
  code String @unique

  // Professor dono da sala
  teacherId String

  // Escola é opcional
  schoolId String?

  teacher User @relation(
    "TeacherClassrooms",
    fields: [teacherId],
    references: [id],
    onDelete: Cascade
  )

  school School? @relation(
    fields: [schoolId],
    references: [id],
    onDelete: SetNull
  )

  // Alunos/membros
  members ClassroomMember[]

  // Aulas
  lessons Lesson[]

  // Glossários da sala
  glossaries Glossary[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([schoolId])
}

// =========================
// CLASSROOM MEMBER
// =========================

model ClassroomMember {
  classroomId String
  userId      String

  classroom Classroom @relation(
    fields: [classroomId],
    references: [id],
    onDelete: Cascade
  )

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  joinedAt DateTime @default(now())

  // Impede que o mesmo aluno entre
  // duas vezes na mesma sala
  @@id([classroomId, userId])

  @@index([userId])
}

// =========================
// LESSON
// =========================

model Lesson {
  id String @id @default(uuid())

  title       String
  description String?

  // Planejamento da aula
  lessonPlan String?

  status LessonStatus @default(AGENDADA)

  // Sala da aula
  classroomId String

  // Professor responsável
  teacherId String

  // Glossário específico opcional
  glossaryId String?

  classroom Classroom @relation(
    fields: [classroomId],
    references: [id],
    onDelete: Cascade
  )

  teacher User @relation(
    "TeacherLessons",
    fields: [teacherId],
    references: [id],
    onDelete: Cascade
  )

  glossary Glossary? @relation(
    fields: [glossaryId],
    references: [id],
    onDelete: SetNull
  )

  startedAt  DateTime?
  finishedAt DateTime?

  materials Material[]

  transcriptionSessions TranscriptionSession[]

  summary Summary?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classroomId])
  @@index([teacherId])
  @@index([glossaryId])
  @@index([status])
}

// =========================
// MATERIAL
// =========================

model Material {
  id String @id @default(uuid())

  name String
  url  String
  type MaterialType

  lessonId     String?
  uploadedById String

  lesson Lesson? @relation(
    fields: [lessonId],
    references: [id],
    onDelete: Cascade
  )

  uploadedBy User @relation(
    "UploadedMaterials",
    fields: [uploadedById],
    references: [id],
    onDelete: Cascade
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
  @@index([uploadedById])
}

// =========================
// TRANSCRIPTION
// =========================

model TranscriptionSession {
  id String @id @default(uuid())

  status SessionStatus @default(ATIVA)

  // Quem iniciou a transcrição
  userId String

  // Aula relacionada
  lessonId String?

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  lesson Lesson? @relation(
    fields: [lessonId],
    references: [id],
    onDelete: Cascade
  )

  // Transcrição completa
  transcript String?

  // Partes da transcrição
  segments TranscriptSegment[]

  startedAt  DateTime @default(now())
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([lessonId])
  @@index([status])
}

// =========================
// TRANSCRIPT SEGMENT
// =========================

model TranscriptSegment {
  id String @id @default(uuid())

  sessionId String

  text String

  // Tempo do áudio em segundos
  startTime Float?
  endTime   Float?

  session TranscriptionSession @relation(
    fields: [sessionId],
    references: [id],
    onDelete: Cascade
  )

  createdAt DateTime @default(now())

  @@index([sessionId])
}

// =========================
// SUMMARY
// =========================

model Summary {
  id String @id @default(uuid())

  // Uma aula possui um resumo
  lessonId String @unique

  content String

  lesson Lesson @relation(
    fields: [lessonId],
    references: [id],
    onDelete: Cascade
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// GLOSSARY
// =========================

model Glossary {
  id String @id @default(uuid())

  name        String
  description String?
  subject     String

  // Professor que criou
  ownerId String

  // Sala onde o glossário é utilizado
  classroomId String?

  owner User @relation(
    fields: [ownerId],
    references: [id],
    onDelete: Cascade
  )

  classroom Classroom? @relation(
    fields: [classroomId],
    references: [id],
    onDelete: Cascade
  )

  terms GlossaryTerm[]

  // Aulas que utilizam este glossário
  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([classroomId])
  @@index([subject])
}

// =========================
// GLOSSARY TERM
// =========================

model GlossaryTerm {
  id String @id @default(uuid())

  // Palavra original
  term String

  // Explicação da palavra
  definition String?

  // Forma corrigida para auxiliar
  // reconhecimento/transcrição
  correction String?

  // Representação utilizada
  // na tradução para Libras
  librasValue String?

  glossaryId String

  glossary Glossary @relation(
    fields: [glossaryId],
    references: [id],
    onDelete: Cascade
  )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([glossaryId])
  @@index([term])
}

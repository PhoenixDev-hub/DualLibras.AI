# Variáveis VITE_* são públicas e incorporadas no build. Nunca coloque segredos aqui.
VITE_BACKEND_HOST=localhost
VITE_BACKEND_PORT=5455
# URLs explícitas têm precedência sobre HOST/PORT.
VITE_BACKEND_HTTP_URL=http://localhost:5455
VITE_BACKEND_WS_URL=ws://localhost:5455/ws
VITE_AUTH_BACKEND_HTTP_URL=http://localhost:4000

# Usado pelo Docker Compose na raiz. Valores fictícios; substitua antes de iniciar.
POSTGRES_USER=festival
POSTGRES_PASSWORD=senha_ficticia
POSTGRES_DB=festival
# Dentro da rede Compose o PostgreSQL é acessado pelo nome db.
DATABASE_URL=postgresql://festival:senha_ficticia@db:5432/festival
DIRECT_URL=postgresql://festival:senha_ficticia@db:5432/festival
JWT_SECRET=substitua_por_um_segredo_local
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=festival_session
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost
# PORT é a porta da API Express; o serviço de IA define sua porta separadamente.
PORT=4000
ASSEMBLYAI_API_KEY=
# Endereços públicos acessíveis pelo navegador; incorporados na imagem do frontend.
VITE_BACKEND_HTTP_URL=http://localhost:5455
VITE_BACKEND_WS_URL=ws://localhost:5455/ws
VITE_AUTH_BACKEND_HTTP_URL=http://localhost:4000
# Ajustes do transcritor local. Mais opções em server/ai/.env.example e app/config.py.
LOCAL_FALLBACK_MODEL=medium
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_CPU_THREADS=6
LOCAL_WHISPER_BEAM_SIZE=2
LOCAL_TRANSCRIPTION_CHUNK_SECONDS=2.5
LOCAL_TRANSCRIPTION_MIN_SECONDS=1.2

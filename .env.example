# Docker Compose: only public gateway is exposed, on loopback behind your TLS proxy.
PUBLIC_ORIGIN=https://aulas.example.org
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
NODE_ENV=production
COOKIE_SECURE=true
# Runtime secrets. Generate independent random values; never use VITE_* for these.
POSTGRES_USER=festival
POSTGRES_DB=festival
POSTGRES_PASSWORD=
DATABASE_URL=
# Optional direct PostgreSQL connection for migrations; falls back to DATABASE_URL.
DIRECT_URL=
JWT_SECRET=
AI_INTERNAL_TOKEN=
JWT_EXPIRES_IN=7d
# Runtime only; needed for real transcription. Offline tests do not use it.
ASSEMBLYAI_API_KEY=
# Limits apply to one worker/replica. Do not scale without a shared limiter.
AUTH_LOGIN_LIMIT=20
AUTH_SIGNUP_LIMIT=5
CLASSROOM_JOIN_LIMIT=20
AI_REQUESTS_PER_MINUTE=60
AI_HTTP_MAX_BYTES=37748736
MATERIAL_MAX_BYTES=26214400
AI_MAX_SESSIONS=4
AI_MAX_SESSIONS_PER_USER=1
AI_SESSION_MAX_SECONDS=3600
AI_AUTH_RECHECK_SECONDS=5
AI_WS_STARTS_PER_MINUTE=6
# Optional local model tuning; first use may download a model.
LOCAL_FALLBACK_MODEL=medium
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_CPU_THREADS=6
LOCAL_WHISPER_BEAM_SIZE=2
LOCAL_TRANSCRIPTION_CHUNK_SECONDS=2.5
LOCAL_TRANSCRIPTION_MIN_SECONDS=1.2
